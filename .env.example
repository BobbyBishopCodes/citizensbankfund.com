# Local portfolio engine. Never use VITE_ prefixes for these secrets.
FINNHUB_API_KEY=
# Required only for the local HTTP API: choose a random token of 24+ characters.
# This is rlly only ever going to be used, if we switch to a non-static webpage for concurrent updates of stock prices etc.
PORTFOLIO_ADMIN_TOKEN=
PORTFOLIO_PORT=8788
PORTFOLIO_REFRESH_MS=300000
# Defaults to .local/portfolio, excluded from git and static site builds.
# PORTFOLIO_DATA_DIR=
